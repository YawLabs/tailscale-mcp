node_modules/
dist/
*.tgz
.env
.env.local
.claude/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Playwright MCP browser-automation artifacts (page snapshots, console logs)
.playwright-mcp/

# Single-binary (Node SEA) build pipeline outputs
bin/*
!bin/tailscale-mcp.mjs
build-tmp/
dist-release/

# oam.js bytecode cache. Created in the working directory by any `oam run` /
# `oam check` / `oam compile` invocation, so anyone who follows the optional
# oam instructions in the README gets it whether or not they opted into
# anything. Ignored rather than removed -- it is a cache and reusing it is the
# point.
oam/

# npm auth token -- never commit (a project-local .npmrc can be
# created by tooling and would carry a live automation token)
.npmrc

# Live shape probe harness state (scripts/live-probe.mjs). The DEFAULT location
# is outside the repo entirely -- %LOCALAPPDATA% / $XDG_STATE_HOME -- because
# the file holds a disposable tailnet's OAuth client secret and mode 0600 is a
# no-op on Windows. These lines cover an operator who points
# TS_PROBE_STATE_DIR somewhere convenient and lands in the working tree; the
# harness also refuses to write a state path inside the repo that git does not
# already ignore.
probe-state.json
.probe-target.json
cleanup-journal.json
